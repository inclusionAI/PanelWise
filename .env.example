# Copy to .env only if your shell or process manager loads dotenv files.
# PanelWise reads the variable named by provider.api_key_env in panelwise.yaml.

# Default provider in panelwise.example.yaml
OPENROUTER_API_KEY=sk-or-...

# When provider.name is zenmux
# ZENMUX_API_KEY=...

# When provider.name is openai-compatible and api_key_env is unchanged
# PANELWISE_API_KEY=...
