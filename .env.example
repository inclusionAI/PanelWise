# 复制为 .env 并填入你的 key
# 默认继续使用 OpenRouter。切 ZenMux 时设 MODEL_PROVIDER=zenmux。
MODEL_PROVIDER=openrouter

# OpenRouter 一个 key 就能同时调 DeepSeek（被测 agent）和 Gemini（裁判）
OPENROUTER_API_KEY=sk-or-...

# ZenMux（MODEL_PROVIDER=zenmux 时必填）
# ZENMUX_API_KEY=...
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# ZENMUX_MODEL_MAP={"openai/gpt-5.5":"openai/gpt-5.1"}
# 1 = strip response_format and inject JSON schema into the prompt. This is the
# current default because ZenMux returned 400 for this repo's strict schema payload.
# Set to 0 only after confirming a chosen ZenMux model accepts response_format.
# ZENMUX_JSON_SCHEMA_FALLBACK=1

# 自建 research agent 默认使用直连 Exa 搜索。ZenMux 首版必须使用 exa，
# native/exa_or 依赖 OpenRouter server tools。
# EXA_API_KEY=...
# RESEARCH_SEARCH_BACKEND=exa
# Local httpx page fetch for the self-managed research agent. Enabled by default
# to preserve historical behavior; set to 0 to expose search-only research.
# This does not control OpenRouter's provider-hosted web_fetch tool.
RESEARCH_ENABLE_DIRECT_FETCH=1
# Historical PanelWise behavior leaves direct web_fetch unblocked. Set to 1
# for contamination-safe comparison runs, and use the same setting for all providers.
# ENFORCE_BLOCKED_FETCH=0
# fusion_full.py always records lightweight fetch/block counters. Set to 1 only
# when you need full per-panel research trajectories in each task record.
# FUSION_SAVE_TRAJECTORY=0

# 可选：HuggingFace token（DRACO 是公开 MIT 数据集，一般不需要）
# HF_TOKEN=hf_...

# 可选：覆盖默认模型 slug（去 openrouter.ai/models 核对确切 slug）
# AGENT_MODEL=deepseek/deepseek-v4-pro
# JUDGE_MODEL=google/gemini-3-pro
